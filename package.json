{
  "name": "law-portal",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "tokens:build": "pnpm --filter @law-portal/design-tokens build",
    "api:generate": "pnpm --filter @law-portal/api-client generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
