---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../lib/blogPosts";
---

<BaseLayout
  locale="ar"
  path="/blog"
  altPath="/en/blog"
  title="المدونة · بوابة القانون"
  description="مقالات تعريفية عامة حول الإجراءات القانونية الشائعة في السعودية."
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-ink">المدونة</h1>
    <p class="mt-2 text-ink-soft">مقالات تعريفية عامة — ليست استشارة قانونية.</p>

    <div class="mt-8 flex flex-col divide-y divide-border">
      {blogPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group flex flex-col gap-1 py-5">
          <span class="font-mono text-xs text-ink-faint">{post.publishDate}</span>
          <span class="font-display text-lg font-semibold text-ink group-hover:text-seal">{post.titleAr}</span>
          <span class="text-sm text-ink-soft">{post.excerptAr}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
