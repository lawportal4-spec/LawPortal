---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqItems } from "../lib/copy";

const items = faqItems.ar;
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  locale="ar"
  path="/faq"
  altPath="/en/faq"
  title="الأسئلة الشائعة · بوابة القانون"
  description="إجابات على أكثر الأسئلة تكرارًا حول الترخيص والدفع والتفاوض على بوابة القانون."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-ink">الأسئلة الشائعة</h1>
    <div class="mt-8 flex flex-col divide-y divide-border">
      {items.map((item) => (
        <details class="group py-4">
          <summary class="cursor-pointer list-none font-medium text-ink [&::-webkit-details-marker]:hidden">
            <span class="me-2 text-rubric">؟</span>
            {item.q}
          </summary>
          <p class="mt-3 text-sm text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
