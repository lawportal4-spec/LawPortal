---
import { nav, CLIENT_APP_URL, type Locale } from "../lib/copy";

interface Props {
  locale: Locale;
  altPath: string;
}

const { locale, altPath } = Astro.props;
const isAr = locale === "ar";
const prefix = isAr ? "" : "/en";
const t = nav[locale];
---

<header class="border-b border-border bg-surface-raised">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={isAr ? "/" : "/en/"} class="flex items-baseline gap-2">
      <span class="font-display text-lg font-bold text-seal">{isAr ? "بوابة القانون" : "Law Portal"}</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-ink-soft md:flex">
      <a href={`${prefix}/`} class="hover:text-seal">{t.home}</a>
      <a href={`${prefix}/services`} class="hover:text-seal">{t.services}</a>
      <a href={`${prefix}/faq`} class="hover:text-seal">{t.faq}</a>
      <a href={`${prefix}/blog`} class="hover:text-seal">{t.blog}</a>
      <a href={`${prefix}/join-as-lawyer`} class="hover:text-seal">{t.joinAsLawyer}</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={altPath}
        class="rounded-md border border-border px-2.5 py-1.5 text-xs font-medium text-ink-soft hover:border-seal hover:text-seal"
      >
        {isAr ? "English" : "العربية"}
      </a>
      <a
        href={CLIENT_APP_URL}
        class="rounded-md bg-seal px-3.5 py-1.5 text-sm font-medium text-seal-on hover:bg-seal-strong"
      >
        {t.openApp}
      </a>
    </div>
  </div>
  <nav class="flex items-center gap-4 overflow-x-auto border-t border-border px-4 py-2 text-sm font-medium text-ink-soft md:hidden">
    <a href={`${prefix}/`} class="whitespace-nowrap hover:text-seal">{t.home}</a>
    <a href={`${prefix}/services`} class="whitespace-nowrap hover:text-seal">{t.services}</a>
    <a href={`${prefix}/faq`} class="whitespace-nowrap hover:text-seal">{t.faq}</a>
    <a href={`${prefix}/blog`} class="whitespace-nowrap hover:text-seal">{t.blog}</a>
    <a href={`${prefix}/join-as-lawyer`} class="whitespace-nowrap hover:text-seal">{t.joinAsLawyer}</a>
  </nav>
</header>
